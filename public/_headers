# Cloudflare Pages response headers for the hosted site.
# The service worker must be re-checked on every visit, or an old one can hold back updates.
/sw.js
  Cache-Control: no-cache
# Built files have a content hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
