{
  "name": "monolith",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "relay:dev": "npm --prefix relay run dev",
    "relay:deploy": "npm --prefix relay run deploy",
    "relay:smoke": "npm --prefix relay run smoke --",
    "test:dates": "node scripts/test-dates.ts",
    "test:e2e": "playwright test --trace off",
    "test": "npm run test:dates && npm run test:e2e",
    "check": "tsc -b && oxlint && npm run test:dates"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
