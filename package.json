    "@fontsource-variable/newsreader": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@litert-lm/core": "0.19.0",
    "@mlc-ai/web-llm": "0.2.86",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-typography": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "ical.js": "2.1.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "perfect-freehand": "^1.2.3",
    "phonon-tts": "0.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
